import sys
import numpy as np
from PyQt6 import QtWidgets, uic, QtGui, QtCore
from skimage import exposure
import matplotlib
matplotlib.use('QtAgg')
from matplotlib.backends.backend_qtagg import FigureCanvasQTAgg as FigureCanvas
from matplotlib.figure import Figure
import matplotlib.pyplot as plt

class AplikasiCitra(QtWidgets.QDialog):
    def __init__(self):
        super().__init__()
        
        #connect ke file ui
        uic.loadUi("image_enchance.ui", self)
        self.file_path = ""
        self.img_rgb = None
        self.img_ahe = None
        
        #tabel komparasi
        if self.tabel_komparasi.columnCount() < 4:
            self.tabel_komparasi.setColumnCount(4)
            self.tabel_komparasi.setHorizontalHeaderLabels(["Jenis Filter", "Kernel", "MSE", "PSNR (dB)"])

        #connect image uploaded ke 2 tabsheet
        self.btn_upload.clicked.connect(self.upload_gambar)
        self.btn_proses.clicked.connect(self.proses_ahe)
        self.btn_histogram.clicked.connect(self.tampilkan_histogram)
        self.btn_jalankan_filter.clicked.connect(self.proses_filter_manual)

    def clear_frame(self, frame):
        if frame.layout() is None:
            frame.setLayout(QtWidgets.QVBoxLayout())
        layout = frame.layout()
        while layout.count():
            child = layout.takeAt(0)
            if child.widget():
                child.widget().deleteLater()

    def tampilkan_gambar_ke_frame(self, img_array, frame):
        self.clear_frame(frame)
        h, w = img_array.shape[:2]
        
        if len(img_array.shape) == 3:
            bytes_per_line = 3 * w
            q_img = QtGui.QImage(img_array.data, w, h, bytes_per_line, QtGui.QImage.Format.Format_RGB888)
        else:
            bytes_per_line = w
            q_img = QtGui.QImage(img_array.data, w, h, bytes_per_line, QtGui.QImage.Format.Format_Grayscale8)
            
        label = QtWidgets.QLabel()
        label.setAlignment(QtCore.Qt.AlignmentFlag.AlignCenter)
        label.setPixmap(QtGui.QPixmap.fromImage(q_img).scaled(frame.size(), QtCore.Qt.AspectRatioMode.KeepAspectRatio))
        frame.layout().addWidget(label)

    def tampilkan_plot_ke_frame(self, channel_data, color, frame):
        self.clear_frame(frame)
        fig = Figure(figsize=(2, 2))
        ax = fig.add_subplot(111)
        hist_vals, _ = np.histogram(channel_data.ravel(), bins=256, range=(0, 256))
        ax.bar(range(256), hist_vals, width=1.0, color=color, alpha=0.6)
        ax.set_xlim([0, 255])
        ax.tick_params(axis='both', which='major', labelsize=6)
        fig.tight_layout(pad=1.0)
        canvas = FigureCanvas(fig)
        frame.layout().addWidget(canvas)

    def tampilkan_panah(self, frame):
        self.clear_frame(frame)
        label = QtWidgets.QLabel("➔")
        label.setAlignment(QtCore.Qt.AlignmentFlag.AlignCenter)
        font = label.font()
        font.setPointSize(40)
        label.setFont(font)
        frame.layout().addWidget(label)


    def hitung_mse_rgb_manual(self, img_asli, img_filter):
        asli_float = img_asli.astype(np.float64)
        filter_float = img_filter.astype(np.float64)
        M, N, C = asli_float.shape
        mse = np.sum((asli_float - filter_float) ** 2) / (M * N * C)
        return mse

    def hitung_psnr_manual(self, mse_value):
        if mse_value == 0:
            return float('inf')
        return 10 * np.log10((255.0 ** 2) / mse_value) 

    def terapkan_filter_rgb_manual(self, img_rgb, kernel_size, tipe="Median"):
        M, N, C = img_rgb.shape
        pad = kernel_size // 2
        img_hasil = np.zeros((M, N, C), dtype=np.uint8)
        
        for ch in range(C):
            channel_2d = img_rgb[:, :, ch]
            img_pad = np.pad(channel_2d, pad_width=pad, mode='constant', constant_values=0)
            chan_hasil = np.zeros((M, N), dtype=np.uint8)
            
            for i in range(M):
                for j in range(N):
                    window = img_pad[i : i+kernel_size, j : j+kernel_size]
                    if tipe.lower() == "median":
                        chan_hasil[i, j] = int(np.median(window))
                    else: 
                        chan_hasil[i, j] = int(np.mean(window))
                        
                #Anti freeze
                if i % 100 == 0:
                    QtWidgets.QApplication.processEvents()
                    
            img_hasil[:, :, ch] = chan_hasil
            
        return img_hasil

    #TABSHEETS 1
    def upload_gambar(self):
        file_name, _ = QtWidgets.QFileDialog.getOpenFileName(self, "Upload Files", "", "Image Files (*.jpg *.png *.jpeg *.bmp)")
        if file_name:
            self.file_path = file_name
            img = plt.imread(self.file_path)
            
            if img.dtype == np.float32 or img.dtype == np.float64:
                img = (img * 255).astype(np.uint8)
                
            if len(img.shape) == 3 and img.shape[2] == 4:
                img = img[:, :, :3]
                
            self.img_rgb = img
            self.tampilkan_gambar_ke_frame(self.img_rgb, self.frame) 
            self.img_ahe = None 
            QtWidgets.QMessageBox.information(self, "Info", "Image Uploaded")

    def proses_ahe(self):
        if self.img_rgb is None: 
            return QtWidgets.QMessageBox.warning(self, "You need to Upload the File First")
            
        img_float = self.img_rgb.astype(float) / 255.0
        processed = exposure.equalize_adapthist(img_float, clip_limit=0.01)
        self.img_ahe = np.clip(processed * 255, 0, 255).astype(np.uint8)
        
        self.tampilkan_gambar_ke_frame(self.img_rgb, self.frame_2)
        self.tampilkan_gambar_ke_frame(self.img_ahe, self.frame_4)
        self.tampilkan_panah(self.frame_3)

    def tampilkan_histogram(self):
        if self.img_rgb is None: return
        self.tampilkan_gambar_ke_frame(self.img_rgb, self.frame)
        self.tampilkan_plot_ke_frame(self.img_rgb[:, :, 0], 'red', self.frame_2)
        self.tampilkan_plot_ke_frame(self.img_rgb[:, :, 1], 'green', self.frame_3)
        self.tampilkan_plot_ke_frame(self.img_rgb[:, :, 2], 'blue', self.frame_4)

    #TABSHEETS 2
    def proses_filter_manual(self):
        if self.img_rgb is None:
            return QtWidgets.QMessageBox.warning(self, "Upload File first")
            
        try:
            teks_kernel = self.input_kernel.text().strip()
            ukuran_kernel = int(teks_kernel)
            if ukuran_kernel < 3 or ukuran_kernel % 2 == 0:
                return QtWidgets.QMessageBox.warning(self, "Kernel berupa angka ganjil")
                
            tipe_filter = self.combo_jenis_filter.currentText()
            
            QtWidgets.QMessageBox.information(self, "Info", "Processing...")
            self.btn_jalankan_filter.setEnabled(False) 
            QtWidgets.QApplication.processEvents() 
            
            #Enchance Raw Image (AHE)
            img_float = self.img_rgb.astype(float) / 255.0
            processed = exposure.equalize_adapthist(img_float, clip_limit=0.01)
            hasil_ahe_awal = np.clip(processed * 255, 0, 255).astype(np.uint8)
            
            #Apply Filter
            hasil_filter = self.terapkan_filter_rgb_manual(hasil_ahe_awal, ukuran_kernel, tipe_filter)
            
            #MSE PSNR
            mse = self.hitung_mse_rgb_manual(hasil_ahe_awal, hasil_filter)
            psnr = self.hitung_psnr_manual(mse)
            
            self.tampilkan_gambar_ke_frame(self.img_rgb, self.frame_asli_f)
            self.tampilkan_gambar_ke_frame(hasil_ahe_awal, self.frame_ahe_f) 
            self.tampilkan_gambar_ke_frame(hasil_filter, self.frame_hasil_filter) 
                
            #Input ke Tabel
            baris_baru = self.tabel_komparasi.rowCount()
            self.tabel_komparasi.insertRow(baris_baru)
            self.tabel_komparasi.setItem(baris_baru, 0, QtWidgets.QTableWidgetItem(tipe_filter))
            self.tabel_komparasi.setItem(baris_baru, 1, QtWidgets.QTableWidgetItem(f"{ukuran_kernel}x{ukuran_kernel}"))
            self.tabel_komparasi.setItem(baris_baru, 2, QtWidgets.QTableWidgetItem(f"{mse:.4f}"))
            self.tabel_komparasi.setItem(baris_baru, 3, QtWidgets.QTableWidgetItem(f"{psnr:.2f}"))
            self.tabel_komparasi.scrollToBottom()
            
            self.btn_jalankan_filter.setEnabled(True) 
            QtWidgets.QMessageBox.information(self, "Info", "Filter has been applied")
            
        except ValueError:
            QtWidgets.QMessageBox.critical(self, "Input berupa nilai angka")
            self.btn_jalankan_filter.setEnabled(True)
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Error", f"Terjadi kesalahan sistem: {str(e)}")
            self.btn_jalankan_filter.setEnabled(True)

if __name__ == "__main__":
    app = QtWidgets.QApplication(sys.argv)
    window = AplikasiCitra()
    window.show()
    sys.exit(app.exec())